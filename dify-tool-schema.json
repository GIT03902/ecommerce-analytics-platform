{
  "openapi": "3.0.0",
  "info": {
    "title": "电商数据分析平台 API",
    "version": "1.0.0",
    "description": "电商销售数据分析与智能预警平台的工具接口，供 Dify Agent 调用获取真实业务数据"
  },
  "servers": [
    {
      "url": "http://host.docker.internal:5000",
      "description": "本地电商分析平台"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/tool/kpis": {
      "get": {
        "summary": "获取核心KPI",
        "description": "获取电商平台核心关键指标，包括总销售额、订单数、客单价、活跃客户数、商品数、平均评分、退货率、复购率等",
        "operationId": "get_kpis",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回KPI数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_sales": { "type": "number", "description": "总销售额(元)" },
                    "total_orders": { "type": "integer", "description": "总订单数" },
                    "avg_order_value": { "type": "number", "description": "客单价(元)" },
                    "active_customers": { "type": "integer", "description": "活跃客户数" },
                    "total_products": { "type": "integer", "description": "商品总数" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tool/monthly-sales": {
      "get": {
        "summary": "获取月度销售趋势",
        "description": "获取近12个月每月的销售额、订单数、客单价趋势数据，用于分析销售走势",
        "operationId": "get_monthly_sales",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回月度销售趋势",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "month": { "type": "string", "description": "月份 YYYY-MM" },
                      "sales": { "type": "number", "description": "销售额(元)" },
                      "orders": { "type": "integer", "description": "订单数" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tool/category-sales": {
      "get": {
        "summary": "获取品类销售分析",
        "description": "获取各商品品类的销售额、订单数、占比数据，用于分析品类表现",
        "operationId": "get_category_sales",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回品类销售数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": { "type": "string", "description": "品类名称" },
                      "sales": { "type": "number", "description": "销售额(元)" },
                      "orders": { "type": "integer", "description": "订单数" },
                      "ratio": { "type": "number", "description": "销售占比" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tool/top-products": {
      "get": {
        "summary": "获取热销商品排行",
        "description": "获取销量Top10的热销商品排行榜，含商品名、销量、销售额",
        "operationId": "get_top_products",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回热销商品排行",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string", "description": "商品名称" },
                      "quantity": { "type": "integer", "description": "销量" },
                      "sales": { "type": "number", "description": "销售额(元)" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tool/low-stock": {
      "get": {
        "summary": "获取低库存预警商品",
        "description": "获取库存量低于安全阈值的商品列表，用于库存预警",
        "operationId": "get_low_stock",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回低库存预警商品",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string", "description": "商品名称" },
                      "stock": { "type": "integer", "description": "当前库存" },
                      "threshold": { "type": "integer", "description": "安全库存阈值" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tool/tier": {
      "get": {
        "summary": "获取客户分层分布",
        "description": "获取基于RFM模型的客户分层分布数据，包括高价值、潜力、一般、流失等客户群体数量和占比",
        "operationId": "get_customer_tiers",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回客户分层分布",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "tier": { "type": "string", "description": "客户分层名称" },
                      "count": { "type": "integer", "description": "客户数量" },
                      "ratio": { "type": "number", "description": "占比" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tool/forecast": {
      "get": {
        "summary": "获取未来7天销量预测",
        "description": "基于随机森林机器学习模型预测未来7天各品类销量，用于备货和运营决策",
        "operationId": "get_forecast",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回销量预测",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": { "type": "string", "description": "预测日期" },
                      "category": { "type": "string", "description": "品类" },
                      "predicted_sales": { "type": "number", "description": "预测销量" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tool/region-sales": {
      "get": {
        "summary": "获取地区销售分布",
        "description": "获取各地区的销售额和订单数分布数据，用于区域市场分析",
        "operationId": "get_region_sales",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回地区销售分布",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "region": { "type": "string", "description": "地区名称" },
                      "sales": { "type": "number", "description": "销售额(元)" },
                      "orders": { "type": "integer", "description": "订单数" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tool/channels": {
      "get": {
        "summary": "获取渠道销售对比",
        "description": "获取各销售渠道（如官网、APP、小程序、第三方平台等）的销售对比数据",
        "operationId": "get_channel_sales",
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回渠道销售对比",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "channel": { "type": "string", "description": "渠道名称" },
                      "sales": { "type": "number", "description": "销售额(元)" },
                      "orders": { "type": "integer", "description": "订单数" },
                      "ratio": { "type": "number", "description": "占比" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}